<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+): the launcher masks the ink plate to whatever
     shape the device uses, and the collage motif sits inside the safe zone.
     The legacy mipmap-*/ic_launcher.png files still serve API 24-25.
     <monochrome> feeds Android 13+ themed icons — the motif is alpha-only,
     so the system tints it without any extra asset. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
